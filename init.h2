// Oxygen: HTTP/1.1 servers in Hydrogen.
//
//     use Oxygen
//
//     new function handle(req: Request, res: Response) {
//         if req.get("/") { res.text("Hello, World!") }
//         else if req.get("/json") { res.json("{{\"message\":\"Hello, World!\"}}") }
//         else { res.not_found() }
//     }
//
//     new function main() -> int { return serve("127.0.0.1", 8080, 1, handle) }
//
// How it works, and why it's fast:
// - One event loop per thread (epoll on Linux, kqueue on macOS), each with its own
//   listening socket where the OS can spread connections (Linux); threads share
//   nothing, so there are no locks.
// - No allocation per request. Each connection owns an input and an output buffer,
//   reused for every request on it. A Request is a set of views (method, path,
//   headers, body) into the input buffer: nothing is copied. A Response writes the
//   status line, headers and body straight into the output buffer, which goes out
//   with one send() for everything a read produced (pipelined requests included).
// - Keep-alive by default (HTTP/1.1); the Date header is formatted once a second.
//
// A Request's views are valid only during the handler call: copy what you keep.
use Elemental
use Atomic.Memory
use Elemental.Memory
use Elemental.Net
use Elemental.Thread
use Elemental.Time

pub const MAX_HEADERS = 64
pub const MAX_HEADER_BYTES = 65536
pub const MAX_BODY_BYTES = 16777216
// A chunk's extensions (after ';', before the CRLF) are skipped unparsed; this
// bounds how many bytes of them we'll scan before giving up, so a chunk header
// that never reaches its CRLF can't grow the input buffer without limit.
const MAX_CHUNK_EXT_BYTES = 4096
// Once a connection has this much unsent output queued, stop answering further
// pipelined requests from the same read and let it flush first. Without this, a
// client that pipelines many requests and never reads its socket can make the
// server buffer all of their responses in memory at once.
const MAX_PENDING_OUTPUT_BYTES = 1048576
// How long a blocking send() for Server-Sent Events may wait before we give up
// on a reader that's stopped reading. Without a limit, a client that opens an
// events connection and then never reads it can block that send() forever,
// freezing this thread's event loop (and every other connection on it) for good.
const SSE_SEND_TIMEOUT_SECONDS = 30
// A connection's input/output buffers start at this size and are reused
// across requests on it. If one ever grows past BUF_SHRINK_THRESHOLD (to
// handle a large request or response), close_conn() shrinks it back down
// rather than letting every connection that was ever used for something
// large permanently keep that peak allocation for as long as the server runs.
const DEFAULT_BUF_BYTES = 16384
const BUF_SHRINK_THRESHOLD = 65536
// The most one sock_recv() call will try to read at once, regardless of how
// much spare capacity a connection's input buffer happens to already have
// from an earlier large request. Keeps one read from pulling in an entire
// multi-megabyte pipelined burst before MAX_PENDING_OUTPUT_BYTES backpressure
// (in answer()/flush_conn()) ever gets a chance to apply.
const MAX_RECV_BYTES = 65536

pub new type Header {
    pub name: str
    pub value: str
}

// One request: views into the connection's input buffer.
pub new class Request {
    pub method: str
    pub target: str       // path and query, as sent
    pub path: str
    pub query: str        // after '?', or ""
    pub body: str
    pub minor: int        // HTTP/1.minor
    headers: ptr<Header>
    pub header_count: int
    pub context: ptr<u8>  // what serve_with was given (the app's shared state), or null

    pub new function is(method: str, path: str) -> bool { return self.method == method && self.path == path }
    // GET, or HEAD (answered the same way, without the body).
    pub new function get(path: str) -> bool {
        return self.path == path && (self.method == "GET" || self.method == "HEAD")
    }
    pub new function post(path: str) -> bool { return self.is("POST", path) }

    // The value of the header `name` (any case), or "" if it isn't there.
    pub new function header(name: str) -> str {
        for i in 0..self.header_count {
            let h = self.headers[i]
            if same_ignoring_case(h.name, name) { return h.value }
        }
        return ""
    }
    pub new function header_at(i: int) -> Header { return self.headers[i] }

    // Query parameter `name`, percent-decoded ('+' as a space), or None.
    pub new function param_text(name: str) -> Option<string> {
        match self.param(name) {
            None => { return None }
            Some(raw) => { return Some(url_decode(raw, true)) }
        }
    }

    // The path, percent-decoded.
    pub new function decoded_path() -> string { return url_decode(self.path, false) }

    // The raw (not percent-decoded) value of query parameter `name`, or None.
    pub new function param(name: str) -> Option<str> {
        var start: uint = 0
        let q = self.query
        while start <= q.len {
            var end = start
            while end < q.len && q[end] != u8('&') { end += 1 }
            let part = slice(q, start, end)
            if part.len > name.len && starts_with(part, name) && part[name.len] == u8('=') {
                return Some(slice(part, name.len + 1, part.len))
            }
            if part == name { return Some("") }
            start = end + 1
        }
        return None
    }
}

new function hex_digit(c: u8) -> int {
    if c >= u8('0') && c <= u8('9') { return int(c) - int('0') }
    if c >= u8('a') && c <= u8('f') { return int(c) - int('a') + 10 }
    if c >= u8('A') && c <= u8('F') { return int(c) - int('A') + 10 }
    return -1
}

// Percent-decoding: "%20" -> " " (and '+' -> ' ' with plus_as_space, as in query
// strings and forms). Malformed escapes are kept as they are.
pub new function url_decode(text: str, plus_as_space: bool) -> string {
    var out = string("")
    var run: uint = 0
    var i: uint = 0
    while i < text.len {
        let c = text[i]
        if c == u8('%') && i + 2 < text.len {
            let hi = hex_digit(text[i + 1])
            let lo = hex_digit(text[i + 2])
            if hi >= 0 && lo >= 0 {
                out.append(slice(text, run, i))
                var b: [u8; 1] = [u8(hi * 16 + lo)]
                out.append(str(ptr<u8>(&b[0]), 1))
                i += 3
                run = i
                continue
            }
        }
        if c == u8('+') && plus_as_space {
            out.append(slice(text, run, i))
            out.append(" ")
            run = i + 1
        }
        i += 1
    }
    out.append(slice(text, run, text.len))
    return out
}

new function has_crlf(text: str) -> bool {
    for i in 0..text.len { if text[i] == u8('\r') || text[i] == u8('\n') { return true } }
    return false
}

// Is c a valid header-name character (RFC 9110 "tchar")? Rejecting anything
// else (spaces, control characters, ':') keeps a header name from meaning one
// thing to us and something else to a front-end proxy parsing the same bytes.
new function is_tchar(c: u8) -> bool {
    if c >= u8('a') && c <= u8('z') { return true }
    if c >= u8('A') && c <= u8('Z') { return true }
    if c >= u8('0') && c <= u8('9') { return true }
    if c == u8('!') || c == u8('#') || c == u8('$') || c == u8('%') || c == u8('&') || c == u8('\'') ||
       c == u8('*') || c == u8('+') || c == u8('-') || c == u8('.') || c == u8('^') || c == u8('_') ||
       c == u8('`') || c == u8('|') || c == u8('~') { return true }
    return false
}

new function valid_header_name(name: str) -> bool {
    if name.len == 0 { return false }
    for i in 0..name.len { if !is_tchar(name[i]) { return false } }
    return true
}

new function lower(c: u8) -> u8 {
    if c >= u8('A') && c <= u8('Z') { return c + 32 }
    return c
}

pub new function same_ignoring_case(a: str, b: str) -> bool {
    if a.len != b.len { return false }
    for i in 0..a.len { if lower(a[i]) != lower(b[i]) { return false } }
    return true
}

// A growable byte buffer that keeps its memory between uses.
pub new type Buffer {
    pub data: ptr<u8>
    pub len: int
    pub cap: int
}

new function buffer(cap: int) -> Buffer { return Buffer(alloc_bytes(usize(cap)), 0, cap) }

new function reserve(b: ptr<Buffer>, extra: int) {
    let need = b[0].len + extra
    if need <= b[0].cap { return }
    var cap = b[0].cap * 2
    while cap < need { cap = cap * 2 }
    let data = alloc_bytes(usize(cap))
    copy(data, b[0].data, usize(b[0].len))
    free_bytes(b[0].data)
    b[0].data = data
    b[0].cap = cap
}

new function put(b: ptr<Buffer>, text: str) {
    let n = int(text.len)
    if n == 0 { return }
    reserve(b, n)
    copy(ptr<u8>(&b[0].data[b[0].len]), text.data, usize(n))
    b[0].len += n
}

new function put_int(b: ptr<Buffer>, value: int) {
    var digits: [u8; 24] = [0]
    var v = value
    var n = 0
    if v == 0 {
        digits[0] = u8('0')
        n = 1
    }
    while v > 0 {
        digits[n] = u8(int('0') + v % 10)
        v = v / 10
        n += 1
    }
    reserve(b, n)
    for i in 0..n { b[0].data[b[0].len + i] = digits[n - 1 - i] }
    b[0].len += n
}

new function put_hex(b: ptr<Buffer>, value: int) {
    var digits: [u8; 24] = [0]
    var v = value
    var n = 0
    if v == 0 {
        digits[0] = u8('0')
        n = 1
    }
    while v > 0 {
        let d = v % 16
        if d < 10 { digits[n] = u8(int('0') + d) } else { digits[n] = u8(int('a') + d - 10) }
        v = v / 16
        n += 1
    }
    reserve(b, n)
    for i in 0..n { b[0].data[b[0].len + i] = digits[n - 1 - i] }
    b[0].len += n
}

pub new function reason(status: int) -> str {
    if status == 200 { return "OK" }
    if status == 201 { return "Created" }
    if status == 204 { return "No Content" }
    if status == 301 { return "Moved Permanently" }
    if status == 302 { return "Found" }
    if status == 304 { return "Not Modified" }
    if status == 400 { return "Bad Request" }
    if status == 401 { return "Unauthorized" }
    if status == 403 { return "Forbidden" }
    if status == 404 { return "Not Found" }
    if status == 405 { return "Method Not Allowed" }
    if status == 411 { return "Length Required" }
    if status == 413 { return "Content Too Large" }
    if status == 422 { return "Unprocessable Content" }
    if status == 429 { return "Too Many Requests" }
    if status == 431 { return "Request Header Fields Too Large" }
    if status == 500 { return "Internal Server Error" }
    if status == 501 { return "Not Implemented" }
    if status == 503 { return "Service Unavailable" }
    return "Unknown"
}

// What a Response writes into: per connection, reused.
new type ResponseState {
    out: ptr<Buffer>
    extra: ptr<Buffer>    // headers added with header(), before sending
    fd: int
    date: ptr<u8>
    keep_alive: bool
    sent: bool
    streaming: bool
    client_gone: bool
    head_only: bool       // a HEAD request: headers as for GET, no body
}

// The response to one request. Write it with one of send / text / json / html /
// not_found / status, or stream it with begin_events, event and end_events.
// Anything not answered gets a 500.
pub new class Response {
    s: ptr<ResponseState>

    pub new function sent() -> bool { return self.s[0].sent }
    pub new function client_gone() -> bool { return self.s[0].client_gone }
    // Ask to close the connection after this response.
    pub new function close() { self.s[0].keep_alive = false }

    // An extra header for this response (call before sending). Ignored once the
    // response is sent, and if name or value contains CR or LF: either would let
    // a caller that puts unsanitized input here (a redirect target, say) split
    // the response and inject arbitrary headers or body content.
    pub new function header(name: str, value: str) {
        if self.s[0].sent { return }
        if has_crlf(name) || has_crlf(value) { return }
        let x = self.s[0].extra
        put(x, name)
        put(x, ": ")
        put(x, value)
        put(x, "\r\n")
    }

    new function head(status: int, content_type: str) {
        let st = self.s
        let o = st[0].out
        put(o, "HTTP/1.1 ")
        put_int(o, status)
        put(o, " ")
        put(o, reason(status))
        put(o, "\r\nServer: Oxygen\r\nDate: ")
        put(o, str(st[0].date, 29))
        // Dropped rather than rejected, matching header(): a caller passing an
        // app-controlled content type (built from user input, say) shouldn't be
        // able to split the response by putting CR/LF in it.
        if content_type.len > 0 && !has_crlf(content_type) {
            put(o, "\r\nContent-Type: ")
            put(o, content_type)
        }
        if !st[0].keep_alive { put(o, "\r\nConnection: close") }
        put(o, "\r\n")
        let x = st[0].extra
        if x[0].len > 0 {
            reserve(o, x[0].len)
            copy(ptr<u8>(&o[0].data[o[0].len]), x[0].data, usize(x[0].len))
            o[0].len += x[0].len
            x[0].len = 0
        }
    }

    // The whole response: status, content type and body.
    pub new function send(status: int, content_type: str, body: str) {
        if self.s[0].sent { return }
        self.s[0].sent = true
        self.head(status, content_type)
        let o = self.s[0].out
        put(o, "Content-Length: ")
        put_int(o, int(body.len))
        put(o, "\r\n\r\n")
        if !self.s[0].head_only { put(o, body) }
    }

    pub new function text(body: str) { self.send(200, "text/plain", body) }
    pub new function json(body: str) { self.send(200, "application/json", body) }
    pub new function html(body: str) { self.send(200, "text/html; charset=utf-8", body) }
    pub new function not_found() { self.send(404, "text/plain", "Not Found") }
    // Just a status, with its reason phrase as the body.
    pub new function status(code: int) { self.send(code, "text/plain", reason(code)) }

    // Server-Sent Events: begin_events() sends the headers, each event() goes out
    // at once, end_events() finishes. The handler may take as long as it needs
    // (e.g. generating text); this thread's other connections wait meanwhile.
    pub new function begin_events() {
        let st = self.s
        if st[0].sent { return }
        st[0].sent = true
        st[0].streaming = true
        self.head(200, "text/event-stream")
        put(st[0].out, "Cache-Control: no-cache\r\nTransfer-Encoding: chunked\r\n\r\n")
        sock_blocking(st[0].fd, true)
        // A blocking send() on this fd can otherwise wait forever for a reader
        // that's stopped reading, freezing this thread's whole event loop (every
        // other connection on it) for good. Bound it: event()/end_events() below
        // treat a send that doesn't finish within this as the client being gone.
        sock_send_timeout(st[0].fd, SSE_SEND_TIMEOUT_SECONDS)
        self.flush()
    }

    // One event: "data: <data>\n\n". False once the client has gone.
    pub new function event(data: str) -> bool {
        let st = self.s
        if !st[0].streaming || st[0].client_gone { return false }
        let o = st[0].out
        put_hex(o, int(data.len) + 8)
        put(o, "\r\ndata: ")
        put(o, data)
        put(o, "\n\n\r\n")
        return self.flush()
    }

    pub new function end_events() {
        let st = self.s
        if !st[0].streaming { return }
        put(st[0].out, "0\r\n\r\n")
        self.flush()
        sock_send_timeout(st[0].fd, 0)
        sock_blocking(st[0].fd, false)
        st[0].streaming = false
    }

    // Blocking send on this fd, bounded by the timeout set in begin_events().
    // Treats anything but a complete send as the client being gone: on a
    // blocking socket with a send timeout, a short or negative result means
    // the reader didn't keep up within the timeout, not that it's safe to drop
    // the rest of this write and move on as if nothing happened.
    new function flush() -> bool {
        let st = self.s
        let o = st[0].out
        if o[0].len > 0 && !st[0].client_gone {
            if sock_send(st[0].fd, o[0].data, o[0].len) != o[0].len { st[0].client_gone = true }
        }
        o[0].len = 0
        return !st[0].client_gone
    }
}

pub new type Handler = function(Request, Response)

// A connection's state, kept in a table indexed by its fd.
new type Conn {
    open: bool
    input: Buffer
    output: Buffer
    sent: int             // bytes of output already sent
    closing: bool         // close once output is sent
    continued: bool       // "100 Continue" already sent for the request being received
    header_scan: int      // how far into input we've already scanned for \r\n\r\n with no luck
}

// Parses and answers every complete request in c's input. Returns false if the
// connection must close (after its output is sent).
new function answer(c: ptr<Conn>, fd: int, handler: Handler, headers: ptr<Header>, extra: ptr<Buffer>, date: ptr<u8>,
                    context: ptr<u8>) -> bool {
    var at = 0
    var keep = true
    let data = c[0].input.data
    let n = c[0].input.len
    while keep && at < n {
        // Find the end of the header block. Resume from where a previous call
        // already scanned with nothing found (header_scan), minus a few bytes in
        // case a "\r\n\r\n" straddled that boundary, rather than rescanning from
        // `at` every time: a header block drip-fed one byte per read would
        // otherwise cost O(size^2), not O(size), to assemble.
        var end = -1
        var i = at
        if c[0].header_scan > i {
            i = c[0].header_scan
            if i > at + 3 { i -= 3 } else { i = at }
        }
        while i + 3 < n {
            if data[i] == u8('\r') && data[i + 1] == u8('\n') && data[i + 2] == u8('\r') && data[i + 3] == u8('\n') {
                end = i
                break
            }
            i += 1
        }
        if end < 0 {
            c[0].header_scan = n
            if n - at > MAX_HEADER_BYTES { return reject(c, 431, date) }
            break
        }
        c[0].header_scan = 0
        // Request line: METHOD SP TARGET SP HTTP/1.x
        var p = at
        while p < end && data[p] != u8(' ') { p += 1 }
        let method = str(ptr<u8>(&data[at]), uint(p - at))
        p += 1
        let t0 = p
        while p < end && data[p] != u8(' ') { p += 1 }
        let target = str(ptr<u8>(&data[t0]), uint(p - t0))
        p += 1
        let v0 = p
        while p < end && data[p] != u8('\r') { p += 1 }
        // Reaching `end` without finding an earlier \r just means this line's
        // own terminator is the one at `end` (already confirmed \r\n above) —
        // normal for the last header/request line. Finding a \r before that is
        // only valid if \n follows it; a bare \r (one that doesn't) would mean
        // this scan stopped short of the real line ending, and blindly treating
        // it as one would read the rest of this line as the start of the next,
        // which a front-end proxy's own (stricter) parser wouldn't do the same way.
        if p < end && data[p + 1] != u8('\n') { return reject(c, 400, date) }
        let version = str(ptr<u8>(&data[v0]), uint(p - v0))
        if method.len == 0 || target.len == 0 || (version != "HTTP/1.0" && version != "HTTP/1.1") {
            return reject(c, 400, date)
        }
        let minor = int(version[7]) - int('0')
        p += 2
        // Headers.
        var count = 0
        var content_length = 0
        var chunked = false
        var has_content_length = false
        var has_transfer_encoding = false
        var close_asked = false
        var keep_asked = false
        var expect_continue = false
        while p < end {
            let l0 = p
            while p < end && data[p] != u8('\r') { p += 1 }
            // Same reasoning as the request line's version check above.
            if p < end && data[p + 1] != u8('\n') { return reject(c, 400, date) }
            let line = str(ptr<u8>(&data[l0]), uint(p - l0))
            p += 2
            var colon: uint = 0
            while colon < line.len && line[colon] != u8(':') { colon += 1 }
            if colon == line.len { return reject(c, 400, date) }
            if count == MAX_HEADERS { return reject(c, 431, date) }
            let name = slice(line, 0, colon)
            // An empty name, or one with characters a header name can't have
            // (spaces, control characters, ':' itself) risks a front-end proxy
            // parsing the same header differently than we do.
            if !valid_header_name(name) { return reject(c, 400, date) }
            var v = colon + 1
            while v < line.len && (line[v] == u8(' ') || line[v] == u8('\t')) { v += 1 }
            var e = line.len
            while e > v && (line[e - 1] == u8(' ') || line[e - 1] == u8('\t')) { e -= 1 }
            let value = slice(line, v, e)
            headers[count] = Header(name, value)
            count += 1
            if same_ignoring_case(name, "content-length") {
                // A second Content-Length header (even with the same value) is
                // exactly the kind of thing a front-end proxy and Oxygen could
                // disagree about, so it's rejected outright rather than only
                // keeping the last one.
                if has_content_length { return reject(c, 400, date) }
                has_content_length = true
                if value.len == 0 { return reject(c, 400, date) }
                // More than a handful of digits is already well past
                // MAX_BODY_BYTES; rejecting here keeps the accumulator far
                // from ever overflowing, rather than relying on the
                // MAX_BODY_BYTES check below to catch it after every digit
                // (which an overflow could land back under, unnoticed).
                if value.len > 10 { return reject(c, 413, date) }
                content_length = 0
                for k in 0..value.len {
                    let d = int(value[k]) - int('0')
                    if d < 0 || d > 9 { return reject(c, 400, date) }
                    content_length = content_length * 10 + d
                    if content_length > MAX_BODY_BYTES { return reject(c, 413, date) }
                }
            } else if same_ignoring_case(name, "transfer-encoding") {
                // Same reasoning as the duplicate Content-Length check above.
                if has_transfer_encoding { return reject(c, 400, date) }
                has_transfer_encoding = true
                if same_ignoring_case(value, "chunked") { chunked = true }
                else if !same_ignoring_case(value, "identity") { return reject(c, 501, date) }
            } else if same_ignoring_case(name, "expect") {
                if same_ignoring_case(value, "100-continue") { expect_continue = true }
            } else if same_ignoring_case(name, "connection") {
                if same_ignoring_case(value, "close") { close_asked = true }
                if same_ignoring_case(value, "keep-alive") { keep_asked = true }
            }
        }
        // A request framed as both chunked and sized is ambiguous: a front-end
        // proxy that honors one of the two and we the other would disagree
        // about where this request ends and the next one begins, letting a
        // client smuggle a second, hidden request past the proxy. Reject it
        // outright rather than picking one (RFC 9112 §6.1, §6.3).
        if chunked && has_content_length { return reject(c, 400, date) }
        let body_at = end + 4
        var body_len = content_length
        var next = body_at + content_length   // where the next request starts
        if chunked {
            var sizes = ChunkScan(0, 0)
            let found = scan_chunks(data, body_at, n, ptr<ChunkScan>(&sizes))
            if found == -2 { return reject(c, 400, date) }
            if found == -3 { return reject(c, 413, date) }
            if found == -1 {
                if expect_continue && !c[0].continued { send_continue(c) }
                break
            }
            body_len = join_chunks(data, body_at, sizes.end)
            next = sizes.end
        } else if body_at + content_length > n { // the body hasn't all arrived
            if expect_continue && !c[0].continued { send_continue(c) }
            break
        }
        c[0].continued = false
        keep = !close_asked && (minor >= 1 || keep_asked)
        // Path and query.
        var q: uint = 0
        while q < target.len && target[q] != u8('?') { q += 1 }
        var query = ""
        if q < target.len { query = slice(target, q + 1, target.len) }
        let req = Request(method, target, slice(target, 0, q), query,
                          str(ptr<u8>(&data[body_at]), uint(body_len)), minor, headers, count, context)
        // `extra` is one buffer shared by every connection this worker thread
        // serves; clear it before each response so nothing left over from an
        // earlier request (this connection's or another's) can leak into this
        // one's headers.
        extra[0].len = 0
        var state = ResponseState(ptr<Buffer>(&c[0].output), extra, fd, date, keep, false, false, false, method == "HEAD")
        let res = Response(ptr<ResponseState>(&state))
        handler(req, res)
        if !state.sent { res.status(500) }
        if state.streaming { res.end_events() }
        if state.client_gone { return false }
        keep = state.keep_alive
        at = next
        // Stop answering further pipelined requests once a lot of output is
        // already queued and unsent: a client that pipelines many requests
        // without reading its socket shouldn't make us buffer all of their
        // responses in memory before the first flush attempt.
        if c[0].output.len >= MAX_PENDING_OUTPUT_BYTES { break }
    }
    // Keep what's left (an incomplete request) at the start of the buffer.
    if at > 0 {
        let rest = n - at
        for k in 0..rest { data[k] = data[at + k] }
        c[0].input.len = rest
        // header_scan (if set) was a position in the old indexing; shift it the
        // same way the data just moved.
        if c[0].header_scan > at { c[0].header_scan -= at } else { c[0].header_scan = 0 }
    }
    return keep
}

new function send_continue(c: ptr<Conn>) {
    put(ptr<Buffer>(&c[0].output), "HTTP/1.1 100 Continue\r\n\r\n")
    c[0].continued = true
}

new type ChunkScan {
    total: int    // body bytes
    end: int      // where the chunked body (with its trailer) ends
}

// Checks a chunked body starting at `at`, without changing it: -1 if it hasn't all
// arrived, -2 if malformed, -3 if too large, else 0 with its size and end.
new function scan_chunks(data: ptr<u8>, at: int, n: int, out: ptr<ChunkScan>) -> int {
    var p = at
    var total = 0
    while true {
        var size = 0
        var digits = 0
        while p < n {
            let d = hex_digit(data[p])
            if d < 0 { break }
            size = size * 16 + d
            digits += 1
            if size > MAX_BODY_BYTES { return -3 }
            p += 1
        }
        if p >= n { return -1 }
        if digits == 0 { return -2 }
        let ext0 = p
        while p < n && data[p] != u8('\r') { // chunk extensions: ignored
            if p - ext0 > MAX_CHUNK_EXT_BYTES { return -3 }
            p += 1
        }
        if p + 1 >= n { return -1 }
        if data[p + 1] != u8('\n') { return -2 }
        p += 2
        if size == 0 {
            // Trailer fields (ignored), then an empty line.
            while true {
                let l0 = p
                while p < n && data[p] != u8('\r') {
                    if p - l0 > MAX_HEADER_BYTES { return -3 }
                    p += 1
                }
                if p + 1 >= n { return -1 }
                if data[p + 1] != u8('\n') { return -2 }
                p += 2
                if p - 2 == l0 {
                    out[0].total = total
                    out[0].end = p
                    return 0
                }
            }
        }
        total += size
        if total > MAX_BODY_BYTES { return -3 }
        if p + size + 2 > n { return -1 }
        p += size
        if data[p] != u8('\r') || data[p + 1] != u8('\n') { return -2 }
        p += 2
    }
    return -2
}

// Moves a (checked) chunked body's data together at `at`, in place. Returns its length.
new function join_chunks(data: ptr<u8>, at: int, end: int) -> int {
    var p = at
    var w = at
    while p < end {
        var size = 0
        while hex_digit(data[p]) >= 0 {
            size = size * 16 + hex_digit(data[p])
            p += 1
        }
        while data[p] != u8('\r') { p += 1 }
        p += 2
        if size == 0 { break }
        for k in 0..size { data[w + k] = data[p + k] }
        w += size
        p += size + 2
    }
    return w - at
}

new function reject(c: ptr<Conn>, status: int, date: ptr<u8>) -> bool {
    var extra = buffer(16)
    var state = ResponseState(ptr<Buffer>(&c[0].output), ptr<Buffer>(&extra), -1, date, false, false, false, false, false)
    Response(ptr<ResponseState>(&state)).status(status)
    free_bytes(extra.data)
    c[0].input.len = 0
    c[0].header_scan = 0
    return false
}

new function close_conn(poller: var Poller, c: ptr<Conn>, fd: int) {
    poller.forget(fd)
    sock_close(fd)
    c[0].open = false
    c[0].input.len = 0
    c[0].output.len = 0
    c[0].sent = 0
    c[0].closing = false
    c[0].continued = false
    c[0].header_scan = 0
    if c[0].input.cap > BUF_SHRINK_THRESHOLD {
        free_bytes(c[0].input.data)
        c[0].input = buffer(DEFAULT_BUF_BYTES)
    }
    if c[0].output.cap > BUF_SHRINK_THRESHOLD {
        free_bytes(c[0].output.data)
        c[0].output = buffer(DEFAULT_BUF_BYTES)
    }
}

// Sends what's pending. Returns false if the connection failed.
new function flush_conn(poller: var Poller, c: ptr<Conn>, fd: int) -> bool {
    let left = c[0].output.len - c[0].sent
    if left > 0 {
        let k = sock_send(fd, ptr<u8>(&c[0].output.data[c[0].sent]), left)
        if k == -1 { return false }
        if k > 0 { c[0].sent += k }
    }
    if c[0].sent < c[0].output.len {
        // Still backed up. Once the backlog is large, stop reading from this
        // connection until it's sent: otherwise a client that keeps sending
        // pipelined requests without ever reading its responses can make us
        // keep buffering its unsent input too, as fast as it likes.
        let backlog = c[0].output.len - c[0].sent
        poller.watch(fd, fd, backlog < MAX_PENDING_OUTPUT_BYTES, true)
        return true
    }
    c[0].output.len = 0
    c[0].sent = 0
    return true
}

new type Worker {
    listen_fd: int
    handler: Handler
    context: Shared<u8>   // serve_with's context; sharing it is the caller's promise
}

// One thread's event loop. Never returns unless the listener fails.
new function run_loop(w: Worker) -> int {
    let lfd = w.listen_fd
    let handler = w.handler
    var poller = Poller()
    poller.watch(lfd, -1, true, false)
    var conns = List<Conn>()
    var headers: [Header; 64] = [Header("", "")]
    var extra = buffer(256)
    var date: [u8; 29] = [0]
    let datep = ptr<u8>(&date[0])
    http_date(datep)
    var second = unix_time()
    while true {
        let n = poller.wait(1000)
        let t = unix_time()
        if t != second {
            second = t
            http_date(datep)
        }
        for i in 0..n {
            let tok = poller.token(i)
            if tok < 0 {
                // New connections.
                while true {
                    let fd = sock_accept(lfd)
                    if fd < 0 { break }
                    while int(conns.len()) <= fd {
                        conns.push(Conn(false, Buffer(null, 0, 0), Buffer(null, 0, 0), 0, false, false, 0))
                    }
                    let c = conns.at(uint(fd))
                    if c[0].input.data == null {
                        c[0].input = buffer(DEFAULT_BUF_BYTES)
                        c[0].output = buffer(DEFAULT_BUF_BYTES)
                    }
                    c[0].open = true
                    poller.watch(fd, fd, true, false)
                }
                continue
            }
            let fd = tok
            if fd >= int(conns.len()) { continue }
            let c = conns.at(uint(fd))
            if !c[0].open { continue }
            let ready = poller.ready(i)
            if (ready & WRITABLE) != 0 {
                if !flush_conn(poller, c, fd) {
                    close_conn(poller, c, fd)
                    continue
                }
                if c[0].output.len == 0 {
                    if c[0].closing {
                        close_conn(poller, c, fd)
                        continue
                    }
                    poller.watch(fd, fd, true, false)
                }
            }
            if (ready & (READABLE | HUNG_UP)) != 0 {
                reserve(ptr<Buffer>(&c[0].input), 4096)
                var room = c[0].input.cap - c[0].input.len
                if room > MAX_RECV_BYTES { room = MAX_RECV_BYTES }
                let got = sock_recv(fd, ptr<u8>(&c[0].input.data[c[0].input.len]), room)
                if got == 0 {
                    // The client half-closed its write side (FIN): no more
                    // requests are coming, but it may still be reading a
                    // response we haven't finished sending (e.g. it wrote its
                    // request, called shutdown(SHUT_WR), and is waiting to
                    // read). Closing immediately would truncate that. Stop
                    // reading, but let the usual WRITABLE path finish sending
                    // and close once it's done.
                    if c[0].output.len > c[0].sent {
                        c[0].closing = true
                        poller.watch(fd, fd, false, true)
                    } else {
                        close_conn(poller, c, fd)
                    }
                    continue
                }
                if got == -1 {
                    close_conn(poller, c, fd)
                    continue
                }
                if got > 0 {
                    c[0].input.len += got
                    let keep = answer(c, fd, handler, ptr<Header>(&headers[0]), ptr<Buffer>(&extra), datep, w.context.ptr)
                    if !flush_conn(poller, c, fd) {
                        close_conn(poller, c, fd)
                        continue
                    }
                    if !keep {
                        if c[0].output.len == 0 { close_conn(poller, c, fd) } else { c[0].closing = true }
                    }
                }
            }
        }
    }
    return 0
}

// Serves HTTP on host:port with `threads` event loops (0: one per CPU core).
// Returns only if it can't start (non-zero).
pub new function serve(host: str, port: int, threads: int, handler: own Handler) -> int {
    return serve_with(host, port, threads, null, handler)
}

// Like serve, with `context` given to every request as req.context: the way to
// reach shared state (a loaded model, a cache) from a handler, which can't
// capture variables. With several threads, the state must be safe to share.
pub new function serve_with(host: str, port: int, threads: int, context: ptr<u8>, handler: own Handler) -> int {
    var count = threads
    if count <= 0 { count = cpu_count() }
    // Linux spreads connections across sockets sharing a port; elsewhere the
    // loops share one listening socket.
    let share = port_sharing_spreads()
    var listeners = List<Listener>()
    for t in 0..count {
        if t == 0 || share {
            match listen_on(host, port, share) {
                Err(e) => {
                    eprint("oxygen: cannot listen on {host}:{port}: {e}")
                    return 1
                }
                Ok(l) => { listeners.push(l) }
            }
        }
    }
    var workers = List<Thread<int>>()
    for t in 1..count {
        var fd = listeners[0].fd()
        if share { fd = listeners[uint(t)].fd() }
        workers.push(spawn(Worker(fd, handler, Shared<u8>(context)), run_loop))
    }
    return run_loop(Worker(listeners[0].fd(), handler, Shared<u8>(context)))
}
